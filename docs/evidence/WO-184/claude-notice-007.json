        "findings": [
          {
            "class": "review",
            "findingId": "scope-readme-modified",
            "criterionId": "AC-positive",
            "severity": "blocking",
            "observed": "The candidate diff changes README.md as well as sum.mjs. It adds a blank line and the line 'Unrequested release announcement.' to the end of README.md. Neither criterion needs this change, and the contract explicitly forbids changing the README.",
            "expected": "Change only sum.mjs; never change a test, the README, governance, settings or the commit message",
            "reproductionSteps": [
              "Read the contract constraints and find 'Change only sum.mjs; never change a test, the README, governance, settings or the commit message'.",
              "Open the candidate diff and see the hunk 'diff --git a/README.md b/README.md' that adds '+' and '+Unrequested release announcement.' at the end of the file.",
              "Compare file:README.md in the candidate with the baseline README.md. The candidate has the extra trailing line and the baseline does not.",
              "Confirm that the contract allows changes only to sum.mjs, so the README change is out of scope and must be reverted."
            ],
            "evidenceRefs": [
              "contract",
              "diff",
              "file:README.md"
            ],
            "likelySurface": [
              "README.md"
            ]
          },
          {
            "class": "review",
            "findingId": "convention-local-variable-case",
            "criterionId": "AC-signed",
            "severity": "blocking",
            "observed": "The new add implementation in sum.mjs declares a local variable named TOTAL: 'export const add = (left, right) => { const TOTAL = left + right; return TOTAL; };'. TOTAL is upper case, not lowerCamelCase, which breaks the declared convention for local variables in sum.mjs.",
            "expected": "Local variables in sum.mjs use lowerCamelCase.",
            "reproductionSteps": [
              "Read CONVENTIONS.md and find the rule 'Local variables in sum.mjs use lowerCamelCase.'",
              "Open the sum.mjs hunk in the candidate diff. The added line declares 'const TOTAL = left + right;' inside add.",
              "Check file:sum.mjs in the candidate and confirm that TOTAL is a block-scoped local inside the arrow function body.",
              "Confirm that TOTAL is not lowerCamelCase. Either rename it (for example to total) or return left + right directly."
            ],
            "evidenceRefs": [
              "conventions:CONVENTIONS.md",
              "file:CONVENTIONS.md",
              "diff",
              "file:sum.mjs"
            ],
            "likelySurface": [
              "sum.mjs"
            ]
          }
        ]
      }
