    "source": "import assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync, mkdirSync } from 'node:fs';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\nimport { join, dirname } from 'node:path';\nconst root = process.cwd();\nconst scratch = dirname(fileURLToPath(import.meta.url));\nconst load = p => import(pathToFileURL(join(root,p)));\nconst { routeOrder } = await load('scripts/lib/drive-route.mjs');\nconst { driveLoop, phaseTimeLimit, workerEnvironment, phaseDefinition } = await load('scripts/lib/drive-session.mjs');\nconst { streamObservation } = await load('scripts/lib/drive-stream.mjs');\nconst { readBudgets } = await load('scripts/lib/process-budget.mjs');\nconst { withoutDrivenContext } = await load('scripts/lib/suite-evidence.mjs');\nconst budget = await load('packages/skeleton/dist/src/subagent-budget.js');\nconst results = [];\nconst check = async (name, body) => {\n  try { await body(); results.push({name, result:'pass'}); }\n  catch (e) { results.push({name,result:'fail',error:e.message}); }\n};\nawait check('route cross-product: every phase has one action or an actionable stop', () => {\n  const phases = ['none','active','ready-to-verify','verifying','needs-fix','repairing','verified','final-review','closed','withdrawn'];\n  const variations = [{}, {operatorMode:'analysis'}, {operatorMode:'override'}, {refused:'synthetic-refusal'}, {exhausted:true}, {merged:true,targetMerged:true}, {released:true}];\n  for (const phase of phases) for (const facts of variations) {\n    const r = routeOrder({phase,repositoryId:'target'}, [], facts);\n    assert.notEqual(Boolean(r.action), Boolean(r.stop), `${phase} ${JSON.stringify(facts)}`);\n    if(r.action) { assert.ok(r.role); assert.ok(r.phrase.startsWith('resume: ')); }\n    else { assert.ok(r.stop.reason); assert.ok(r.stop.next.trim()); }\n  }\n  for (const facts of [{merged:true}, {targetMerged:true}, {}]) assert.equal(routeOrder({phase:'closed',repositoryId:'target'}, [], facts).stop.reason,'awaiting-merge');\n});\nawait check('history windows: reactivation, off-ramp acknowledgement and action-specific incomplete bounds', () => {\n  const old = Array.from({length:3},()=>({type:'VerificationCompleted',verdict:'fail'}));\n  assert.equal(routeOrder({phase:'needs-fix'},old).stop.reason,'verification-bound');\n  assert.equal(routeOrder({phase:'needs-fix'},[...old,{type:'WorkOrderActivated'}]).action,'fix');\n  assert.equal(routeOrder({phase:'verifying'},[],{incomplete:{next:2,fix:2}}).action,'verify');\n  assert.equal(routeOrder({phase:'closed'},[],{merged:true,incomplete:{'release-close':2}}).stop.reason,'incomplete-bound');\n  const events=[{type:'CriterionWaived'}];\n  assert.equal(routeOrder({phase:'verified'},events,{attentionSince:0}).stop.reason,'off-ramp');\n  assert.equal(routeOrder({phase:'verified'},events,{attentionSince:1}).action,'final-review');\n});\nawait check('independent driver sequence includes one failed verification and its repair, then stops for merge', async () => {\n  let phase='active', n=0, verifications=0;\n  const actions=[];\n  const record={attempts:[],incomplete:{},factsAt:0};\n  const status=()=>({phase,route:{...routeOrder({phase}),eventCount:n}});\n  const out=await driveLoop({status,record,launch:async r=>{\n    actions.push(r.action); n++;\n    if(r.action==='next'||r.action==='fix') phase='ready-to-verify';\n    if(r.action==='verify') phase=++verifications===1?'needs-fix':'verified';\n    if(r.action==='final-review') phase='closed';\n    return {exitCode:0};\n  }});\n  assert.deepEqual(actions,['next','verify','fix','verify','final-review']);\n  assert.equal(out.stop.reason,'awaiting-merge');\n  assert.equal(out.attempts.length,5);\n  assert.equal(out.incomplete.verify,0);\n});\nawait check('native stream: declined commands stop, malformed rows do not erase valid usage, operands stay private', () => {\n  let stops=0;\n  const s=streamObservation({protocol:'codex',launchpad:root,stop:()=>stops++});\n  s.inspect('{broken'); s.inspect('null');\n  s.inspect(JSON.stringify({type:'thread.started',thread_id:'synthetic-thread'}));\n  s.inspect(JSON.stringify({type:'item.completed',item:{type:'command_execution',command:'node /synthetic/private/release.mjs close WO-999 --publish',status:'declined',aggregated_output:''}}));\n  s.inspect(JSON.stringify({type:'turn.completed',usage:{input_tokens:9,output_tokens:3}}));\n  assert.equal(s.facts.cause,'native-permission-refused'); assert.ok(s.facts.refused); assert.equal(stops,1);\n  assert.equal(s.facts.usage.input_tokens,9);\n  assert.ok(!JSON.stringify(s.observed()).includes('/synthetic/private'));\n});\nawait check('independent budget: duplicate admissions are idempotent, refused admissions charge nothing, another spawner retains its allowance', () => {\n  const f=join(scratch,'counter-independent'); const directory=join(f,'state');\n  mkdirSync(join(f,'docs/control'),{recursive:true});\n  writeFileSync(join(f,'docs/control/budgets.json'),JSON.stringify({subagentCap:2}));\n  assert.equal(budget.initializeSubagentCounter(directory,'independent'),null);\n  const admit=(id,spawner)=>budget.admitSubagentTool(f,directory,{session_id:'independent',tool_use_id:id,tool_name:'Agent'},true,{cap:3,spawnerCap:1,spawner});\n  assert.equal(admit('a','alpha').refusal,undefined);\n  assert.equal(admit('a','alpha').refusal,undefined);\n  assert.ok(admit('a-denied','alpha').refusal);\n  assert.equal(admit('b','beta').refusal,undefined);\n  assert.equal(admit('router','router').refusal,undefined);\n  assert.ok(admit('c-denied','gamma').refusal);\n  assert.equal(budget.subagentUsage(f,directory,'independent').count,3);\n});\nawait check('legacy budgets: absent router keys stay unset', () => {\n  const f=join(scratch,'legacy-budgets'); mkdirSync(join(f,'docs/control'),{recursive:true});\n  const value=JSON.parse(readFileSync(join(root,'docs/control/budgets.json'),'utf8'));\n  delete value.dispatches.router; delete value.limits.coldStartBytes.router;\n  writeFileSync(join(f,'docs/control/budgets.json'),JSON.stringify(value));\n  const read=readBudgets(f);\n  assert.equal(read.dispatches.router.tokens,null); assert.equal(read.dispatches.router.costUsd,null);\n  assert.equal(read.dispatches.router.wallClockMs,null); assert.equal(read.limits.coldStartBytes.router,null);\n});\nawait check('worker identity and driven context do not reach suite environments; deadline admission is exact', () => {\n  const env={CODEX_THREAD_ID:'parent',CLAUDE_CODE_SESSION_ID:'parent',CLAUDE_EFFORT:'max',DOTLN_DRIVEN_WORKER:'context',DOTLN_DRIVE_DEADLINE_AT:'2000',DOTLN_DRIVE_PARENT_PID:'111',CUSTOM:'retained'};\n  const child=workerEnvironment(env);\n  for(const key of ['CODEX_THREAD_ID','CLAUDE_CODE_SESSION_ID','CLAUDE_EFFORT','DOTLN_DRIVEN_WORKER']) assert.equal(child[key],undefined);\n  const suite=withoutDrivenContext(env);\n  for(const key of ['DOTLN_DRIVEN_WORKER','DOTLN_DRIVE_DEADLINE_AT','DOTLN_DRIVE_PARENT_PID']) assert.equal(suite[key],undefined);\n  assert.equal(suite.CUSTOM,'retained');\n  assert.equal(phaseTimeLimit(null,null,'2000',2000),0);\n  assert.equal(phaseTimeLimit(1000,500,'2200',2000),200);\n});\nawait check('both generated verifier definitions keep actual worker pins and the independent verifier effort',async()=>{\n  for(const host of ['claude','codex']) {\n    const phase=await phaseDefinition(root,'verifier',host);\n    assert.equal(phase.definition.model,host==='claude'?'claude-opus-5-5':'gpt-6.1-sol');\n    assert.equal(phase.definition.effort,'xhigh');\n    assert.ok(phase.definition.prompt.includes('immutable VER report') || phase.definition.prompt.includes('immutable report'));\n    assert.ok(phase.helpers['dotln-worker']);\n  }\n});\nconst summary={subject:'WO-192',observedAt:new Date().toISOString(),groups:results,passed:results.filter(r=>r.result==='pass').length,failed:results.filter(r=>r.result==='fail').length};\nwriteFileSync(join(scratch,'independent-probes.json'),JSON.stringify(summary,null,2)+'\\n');\nconsole.log(JSON.stringify(summary,null,2));\nprocess.exitCode=summary.failed?1:0;\n",
