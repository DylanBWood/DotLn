  "semantics": {
    "edge": "an edge from X to Y means X depends on Y under the named relation",
    "blockingRelations": ["hard", "planning-deferral"],
    "conditionalRelations": ["satisfied-by-release", "satisfied-by-close"],
    "nonBlockingRelations": [
      "reference-only",
      "historical-evidence",
      "waived",
      "superseded"
    ],
    "satisfied-by-release": "met while the named local annotated release tag is in HEAD's ancestry; blocking otherwise",
    "satisfied-by-close": "met while the named order is control-closed; blocking otherwise",
    "planning-deferral": "a sequencing decision of this pass, not a missing input; blocks activation until the named node is control-closed or the operator waives it with a dated note",
    "supersedes": "node annotation, never an edge: the slice of an existing order that a filed order carves out, with the rest of that order preserved",
    "supersededBy": "node annotation on an umbrella record: the children that carry every obligation of the umbrella, which is not activatable and keeps its number and text as lineage"
  },
