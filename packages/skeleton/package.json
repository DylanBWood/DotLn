{
  "name": "@dotln/skeleton",
  "version": "0.38.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dotln": "dist/src/dotln.js"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "test": "node ../../scripts/build.mjs && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js",
    "prepublishOnly": "node -e \"console.error('DOTLN_PACKAGE_PUBLISH_REFUSED: packages stay private until a separate publication decision'); process.exit(1)\""
  },
  "dependencies": {
    "@dotln/compiler": "0.17.0",
    "@dotln/kernel": "0.6.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
