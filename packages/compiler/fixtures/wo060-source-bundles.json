        "sections": [
          {
            "id": "s-steps",
            "heading": "Steps to reproduce",
            "text": "1. Open **Settings → Notifications**.\n2. Turn off *Weekly digest* and press **Save**.\n3. Reload the page.",
            "span": {
              "sectionId": "s-steps",
              "start": 0,
              "end": 107
            }
          },
          {
            "id": "s-expected",
            "heading": "Expected behavior",
            "text": "The digest stays off after the reload.",
            "span": {
              "sectionId": "s-expected",
              "start": 0,
              "end": 38
            }
          },
          {
            "id": "s-actual",
            "heading": "Current behavior",
            "text": "The digest is on again, and an error dialog appears:\n\n![Error dialog after saving notification settings](https://github.com/user-attachments/assets/00000000-0000-4000-8000-000000000102)\n\nThe settings reference is at https://docs.github.com/en/account-and-profile.",
            "span": {
              "sectionId": "s-actual",
              "start": 0,
              "end": 263
