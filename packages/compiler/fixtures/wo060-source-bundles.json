    {
      "name": "feature-request",
      "hash": "fnv1a64:1ee60b93ab4ddb62",
      "bundle": {
        "bundleId": "synthetic-issue-101",
        "sourceKind": "synthetic-issue",
        "revisionId": "2026-09-20T12:05:00Z",
        "sections": [
          {
            "id": "s-summary",
            "heading": "Summary",
            "text": "Add a CSV export to the weekly report so a reviewer can share it without screenshots.",
            "span": {
              "sectionId": "s-summary",
              "start": 0,
              "end": 85
            }
          },
          {
            "id": "s-behavior",
            "heading": "Desired behavior",
            "text": "1. The report page shows an **Export CSV** button.\n2. ~~The export includes archived rows.~~ The export leaves archived rows out.\n3. The file name carries the report's week, for example `report-2026-W38.csv`.",
            "span": {
              "sectionId": "s-behavior",
              "start": 0,
              "end": 208
            }
          },
          {
            "id": "s-out-of-scope",
            "heading": "Out of scope",
            "text": "Scheduling exports by e-mail.",
            "span": {
              "sectionId": "s-out-of-scope",
              "start": 0,
              "end": 29
            }
          }
        ],
        "discussion": [
          {
            "id": "e-101-1",
            "author": "reporter",
            "text": "Opening this after the planning call; the numbered list is the whole request.",
            "span": {
              "entryId": "e-101-1",
              "start": 0,
              "end": 77
            },
            "createdAt": "2026-09-20T10:15:00Z"
          },
          {
            "id": "e-101-2",
            "author": "reviewer",
            "text": "Should the export respect the filters that are active on the page?",
            "span": {
              "entryId": "e-101-2",
              "start": 0,
              "end": 66
            },
            "createdAt": "2026-09-20T11:02:00Z"
          },
          {
            "id": "e-101-3",
            "author": "reporter",
            "text": "Yes: the export is what the page shows, filters included.",
            "span": {
              "entryId": "e-101-3",
              "start": 0,
              "end": 57
            },
            "createdAt": "2026-09-20T11:40:00Z"
          }
