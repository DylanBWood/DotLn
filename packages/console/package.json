{
  "name": "@dotln/console",
  "version": "0.5.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/console-client.d.ts",
      "import": "./dist/src/console-client.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "test": "node ../../scripts/build.mjs && node --test dist/test/*.test.js",
    "prepublishOnly": "node -e \"console.error('DOTLN_PACKAGE_PUBLISH_REFUSED: packages stay private until a separate publication decision'); process.exit(1)\""
  },
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@dotln/compiler": "0.34.0",
    "@dotln/kernel": "0.8.0",
    "@dotln/skeleton": "0.74.0"
  }
}
