{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "composite": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "references": [
    { "path": "../compiler" },
    { "path": "../kernel" },
    { "path": "../skeleton" }
  ]
}
