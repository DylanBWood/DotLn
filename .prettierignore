# The format gate covers code only, so source reads like any other project.
# Authored prose, data records, event logs and evidence keep the bytes their
# authors and generators wrote (operator decision 2026-09-13, WO-130-D008).
*.md
*.json
*.jsonl

# An instance's own tools, under the root the kit never enters.
/extensions/

# Local raw material and dependency/build output.
docs/intake/
node_modules/
**/dist/
**/*.tsbuildinfo

# The carried Markdown parser is Prettier's own build, kept byte-identical
# to the pinned package by the vendored-parser check. Only that file is named:
# any other source placed beside it is formatted as the rest are.
scripts/lib/vendor/prettier-markdown.mjs

# Recorded fixture bytes and generated harness code keep their exact bytes.
corpus/fixtures/
corpus/manifests/
corpus/harness/profile.mjs
corpus/harness/wo107-records.mjs
corpus/harness/wo107-scenarios.mjs
corpus/harness/wo107-bounded.mjs
packages/console/fixtures/inputs/
packages/console/fixtures/expected/
.claude/hooks/
.codex/hooks/
