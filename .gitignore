# Raw ideation dumps stay local until synthesized and scrubbed.
# See docs/README.md for why. (Directories are re-included so the
# structure survives a clone; only their contents are ignored.)
docs/intake/**
!docs/intake/**/
!docs/intake/**/.gitkeep

.DS_Store
node_modules/
dist/
*.tsbuildinfo
.env
.env.*
!.env.example

# Exact operator-owned Claude Code settings; no other .claude path is allowed.
/.claude/settings.local.json

# Explicit, rebuildable skeleton beacon output.
/.beacons/
